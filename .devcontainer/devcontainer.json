{
  "name": "Svengelska",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Europe/Stockholm}"
    }
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Brandväggen sätter iptables-regler inifrån containern.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  "remoteUser": "node",

  "mounts": [
    "source=svengelska-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=svengelska-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    // ~/.claude.json ligger utanför ~/.claude, så volymen ovan räcker inte
    // ensam för att slippa logga in igen. Den här pekar filen in i volymen.
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },

  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "angular.ng-template", "eamodio.gitlens"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "zsh" },
          "bash": { "path": "bash", "icon": "terminal-bash" }
        }
      }
    }
  },

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  // Vid varje start, inte bara vid bygget: iptables-regler följer inte med i imagen.
  "postStartCommand": "sudo /usr/local/share/svengelska/init-firewall.sh",
  "waitFor": "postStartCommand"
}
